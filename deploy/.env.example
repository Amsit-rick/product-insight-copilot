# =============================================================================
# 生产环境变量样例（deploy/.env）
# =============================================================================
# 用法：
#   cp deploy/.env.example deploy/.env    # 然后逐项填写
#   docker compose -f deploy/docker-compose.yml up -d --build
#
# 说明：
#   - 本文件只是**样例**，真正的 deploy/.env 不要提交（.gitignore 已排除 .env）。
#   - 这里只列生产必须确认的项；完整清单见 backend/.env.example。
#   - 密钥（LLM_API_KEY / POSTGRES_PASSWORD / MINIO 密钥 / JWT_SECRET）只从环境或本文件注入，
#     绝不写进 docker-compose.yml 与代码。
# =============================================================================

# ---- 基础 ----
APP_ENV=prod
DEBUG=false
# 构建或部署对应的完整 Git SHA；为空时系统状态页会明确显示“证据未绑定当前发布版本”。
APP_RELEASE_SHA=
# 生产部署应引用制品仓库中的不可变 digest；本地构建保持默认 pic-api:local。
# PIC_API_IMAGE=registry.example.com/after-sales/pic-api@sha256:<built-image-digest>
# CI/交付系统生成的独立证据包目录；目录内必须包含报告、检查和 manifest。
# 本地可保持默认仓库目录，生产应挂载不可写的外部制品目录，避免 Git 自引用证据。
DELIVERY_EVIDENCE_HOST_DIR=../docs/testing/artifacts
# 正式交付证据默认 24 小时过期；调大只改变展示门禁，不会自动生成或批准证据。
DELIVERY_EVIDENCE_MAX_AGE_HOURS=24
# 接口文档（/docs、/redoc、/openapi.json）：APP_ENV=prod 时**强制关闭**（main.py 里写死），
# 这里显式写 false 只是把意图说清楚。它们会把全部端点与数据结构公开出去。
EXPOSE_DOCS=false
# 对外域名；生产不要用 *
CORS_ORIGINS=https://pic.your-domain.com
# 直连暴露 API 时保持空；经反向代理时填写明确的代理容器 IP/CIDR，禁止 *
FORWARDED_ALLOW_IPS=

# ---- 认证（必改：随机 32 字节以上）----
JWT_SECRET=please-generate-a-32byte-random-secret
JWT_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=pic_session
AUTH_CSRF_COOKIE_NAME=pic_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_SAMESITE=lax
# 留空=生产按 APP_ENV 自动启用 Secure；仅 HTTPS 部署可显式设置 true
# AUTH_COOKIE_SECURE=true

# ---- 数据库（多副本必须 Postgres）----
POSTGRES_USER=pic
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=pic
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- 模型（密钥只在这里注入）----
LLM_PROVIDER=openai_compatible
REFLECTION_ENABLED=false
REFLECTION_TICKET_ENABLED=true
REFLECTION_REPORT_ENABLED=true
REFLECTION_ROLLOUT_PERCENT=100
REFLECTION_ROLLOUT_SALT=reflection-rollout-v1
REFLECTION_ROLLOUT_TENANTS=[]
REFLECTION_ROLLOUT_RISK_LEVELS=[]
REFLECTION_ROLLOUT_ISSUE_TYPES=[]
REFLECTION_ROLLOUT_AUTO_GUARD=true
REFLECTION_RELEASE_MIN_SAMPLE=20
REFLECTION_RELEASE_ERROR_RATE_LIMIT=0.05
REFLECTION_RELEASE_BOUNDED_TERMINATION_MIN=0.98
REFLECTION_RELEASE_LATENCY_MULTIPLIER=1.5
REFLECTION_RELEASE_TOKEN_MULTIPLIER=1.5
MAX_REFLECTION_ROUNDS=1
REFLECTION_TIMEOUT_SECONDS=30
REFLECTION_MAX_TOKENS=1800
REFLECTION_COST_LIMIT=0
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 按 Agent 覆盖模型（JSON）：报告 Agent 用强推理模型，其余用快模型
AGENT_MODEL_OVERRIDES={"report_agent":{"model":"deepseek-reasoner","timeout_seconds":180,"max_output_tokens":8000}}
# 主模型失败时的降级链
LLM_FALLBACK_MODELS=["deepseek-chat"]

# ---- 售后事实接口（生产必须接真实只读端点）----
TICKET_USE_MOCK_ADAPTERS=false
# 四个端点都必须返回标准化 JSON，URL 必须包含 {order_id}。
TICKET_FACT_ORDER_URL=https://gateway.your-domain.com/orders/{order_id}
TICKET_FACT_PAYMENT_URL=https://gateway.your-domain.com/payments/{order_id}
TICKET_FACT_LOGISTICS_URL=https://gateway.your-domain.com/logistics/{order_id}
TICKET_FACT_AFTERSALE_URL=https://gateway.your-domain.com/aftersales/{order_id}
# 仅示例；deploy/.env 不得提交。也可改用 X-API-Key 等内部网关鉴权头。
TICKET_FACT_AUTH_HEADERS={"Authorization":"Bearer replace-me"}
TICKET_FACT_TIMEOUT_SECONDS=3
TICKET_FACT_MAX_RETRIES=2
TICKET_FACT_RETRY_BACKOFF_SECONDS=0.2

# ---- 成本与预算（至少设一个，否则等于不限额）----
MODEL_PRICES={"deepseek-chat":{"input":2.0,"output":8.0,"cache_hit_input":0.5},"deepseek-reasoner":{"input":4.0,"output":16.0,"cache_hit_input":1.0}}
TASK_TOKEN_LIMIT=200000
TASK_COST_LIMIT=0
TENANT_DAILY_COST_LIMIT=0
BUDGET_EXCEEDED_ACTION=degrade

# ---- 并发与限流（多副本需 Redis 才能全局生效）----
MODEL_MAX_CONCURRENCY=4
TASK_SUBMIT_RATE_LIMIT_PER_MINUTE=20
LOGIN_ATTEMPT_RATE_LIMIT_PER_MINUTE=10
CACHE_BACKEND=redis
# Redis 不可用时的降级后端：sqlite=落盘（重启后仍命中、同机多进程共享）| memory=纯进程内
CACHE_FALLBACK=sqlite
CACHE_SQLITE_PATH=./data/cache.db

# 查询向量缓存：同一段查询文本在多个 Agent 之间只向量化一次
# （接了真实 Embedding 接口时，这直接等于少付几次调用费）
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_MAX_ENTRIES=512

# ---- 向量后端（三档：fallback / pgvector / qdrant）----
# auto 的顺序：配了 QDRANT_URL → qdrant；否则 Postgres → pgvector；否则 fallback。
# 想让 auto 选 pgvector 就把 QDRANT_URL 留空。
VECTOR_BACKEND=auto
EMBEDDING_DIM=1024
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pic_chunks
# HNSW 搜索精度：越大越准越慢
QDRANT_SEARCH_EF=128
# 注意：换向量后端后必须重建索引（向量写在哪由 store 决定，
# pgvector/qdrant 不在关系库里留向量）：python scripts/reindex_vectors.py

# ---- 缓存 TTL（秒）：检索 1800 / 指标 300。
# 结果新鲜度由数据指纹、指标指纹、向量模型身份与 RETRIEVAL_LOGIC_VERSION 各自负责，
# TTL 只兜底"缓存体积"，所以检索这类重活可以放长。
# 注意：.env 里的值会覆盖代码默认值（曾经因为这里钉死 300，让落盘缓存"看起来没生效"）。
RETRIEVAL_CACHE_TTL_SECONDS=1800
METRIC_CACHE_TTL_SECONDS=300

# ---- 任务执行与 worker（多副本形态，详见 README §7.4）----
TASK_EXECUTION_BACKEND=queue
WORKER_EMBEDDED=false
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_MAX_AGE_SECONDS=20
# 单容器资源上限；按目标机器容量和压测结果调整，不要删除边界。
API_CPUS=2.0
API_MEMORY_LIMIT=2g
API_PIDS_LIMIT=256
WORKER_CPUS=2.0
WORKER_MEMORY_LIMIT=2g
WORKER_PIDS_LIMIT=256
MIGRATE_CPUS=1.0
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_PIDS_LIMIT=128
POSTGRES_CPUS=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_PIDS_LIMIT=256
REDIS_CPUS=1.0
REDIS_MEMORY_LIMIT=512m
REDIS_PIDS_LIMIT=128
MINIO_CPUS=1.0
MINIO_MEMORY_LIMIT=1g
MINIO_PIDS_LIMIT=256
# 自动回滚等严重告警的站外 Webhook。未配置 HTTPS 接收端和 HMAC 密钥前保持 false。
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_MAX_ATTEMPTS=5
ALERT_WEBHOOK_RETRY_BASE_SECONDS=10
ALERT_WEBHOOK_POLL_INTERVAL_SECONDS=2
ALERT_WEBHOOK_LEASE_SECONDS=30
# 只读主动异常触发器默认关闭；由单实例调度器调用扫描接口，避免多 API 副本重复调度。
PROACTIVE_ANOMALY_ENABLED=false
PROACTIVE_ANOMALY_METRICS=["next_day_retention","crash_rate"]
PROACTIVE_ANOMALY_LOOKBACK_DAYS=30
PROACTIVE_ANOMALY_MAX_DATA_AGE_DAYS=2
PROACTIVE_ANOMALY_MAX_DATA_AGE_BY_METRIC={}
PROACTIVE_ANOMALY_METHOD=zscore
PROACTIVE_ANOMALY_THRESHOLD=2.5
PROACTIVE_ANOMALY_INTERVAL_SECONDS=300
PROACTIVE_ANOMALY_LEASE_SECONDS=900
METRIC_SOURCE_HTTP_ENABLED=false
METRIC_SOURCE_HTTP_URL=
METRIC_SOURCE_HTTP_AUTH_HEADERS={}
METRIC_SOURCE_HTTP_TIMEOUT_SECONDS=5
METRIC_SOURCE_HTTP_MAX_RETRIES=2
METRIC_SOURCE_HTTP_RETRY_BACKOFF_SECONDS=0.2
METRIC_SOURCE_HTTP_MAX_ROWS=50000
METRIC_SOURCE_HTTP_MAX_RESPONSE_BYTES=4194304
# 断点恢复：容器内 API/worker 必须共用 Postgres；不要使用各容器独立的 SQLite 文件。
CHECKPOINTER_BACKEND=postgres
# 留空时 Compose 会自动复用业务 Postgres；独立 checkpoint 库可显式覆盖。
CHECKPOINTER_POSTGRES_URL=

# ---- 向量与对象存储 ----
VECTOR_BACKEND=pgvector
STORAGE_BACKEND=minio
# 生产应指向企业 S3 兼容端点并启用 HTTPS；不要启动本地 minio profile。
MINIO_ENDPOINT=storage.example.internal:443
MINIO_ACCESS_KEY=replace-with-least-privilege-access-key
MINIO_SECRET_KEY=replace-with-least-privilege-secret-key
MINIO_SECURE=true
# 下面两项只供 --profile minio 的本地集成环境初始化使用，应用账号可另行覆盖。
MINIO_ROOT_USER=picminio
MINIO_ROOT_PASSWORD=please-change-me
MINIO_BUCKET=pic-documents

# ---- 演示数据（生产关闭：不要自动播种演示文档与账号）----
AUTO_SEED=false
AUTO_INIT_DB=true
