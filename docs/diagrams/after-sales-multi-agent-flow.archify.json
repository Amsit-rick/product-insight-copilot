  "nodes": [
    { "id": "orchestrator", "lane": "orchestration", "col": 0, "type": "messagebus", "label": "LangGraph Orchestrator", "sublabel": "加载状态、路由节点、失败后恢复", "width": 158 },
    { "id": "triage_agent", "lane": "orchestration", "col": 1, "type": "backend", "label": "Triage Agent", "sublabel": "识别问题、风险与缺失信息", "width": 148 },
    { "id": "order_fact_agent", "lane": "facts", "col": 2, "type": "database", "label": "Order Fact Agent", "sublabel": "订单、支付、物流和历史售后", "width": 154 },
    { "id": "policy_rag_agent", "lane": "policy", "col": 2, "type": "cloud", "label": "Policy RAG Agent", "sublabel": "现行政策、适用条件和引用来源", "width": 154 },
    { "id": "evidence_bundle", "lane": "evidence", "col": 3, "type": "database", "label": "Evidence Bundle", "sublabel": "事实 + 条款 + 来源 + 时间 + 置信状态", "width": 170 },
    { "id": "decision_gate", "lane": "decision", "col": 4, "type": "security", "label": "确定性规则门禁", "sublabel": "代码决定动作、金额、风险和审批", "tag": "模型无最终执行权", "width": 162 },
    { "id": "resolution_agent", "lane": "decision", "col": 5, "type": "backend", "label": "Resolution Agent", "sublabel": "生成受约束的处理建议", "width": 150 },
    { "id": "response_agent", "lane": "response", "col": 5, "type": "frontend", "label": "Response Agent", "sublabel": "生成面向客户的回复草稿", "width": 148 },
    { "id": "review_agent", "lane": "reflection", "col": 5, "type": "security", "label": "Review Agent", "sublabel": "独立检查证据、承诺、引用和审批", "width": 154 },
    { "id": "review_outcome", "lane": "outcome", "col": 5, "type": "security", "label": "审核结果判断", "sublabel": "证据不足 / 修订 / 高风险 / 通过", "width": 154 },
    { "id": "retrieve_more", "lane": "branches", "col": 2, "type": "cloud", "label": "补查证据", "sublabel": "只回到取证和规则决策", "width": 140 },
    { "id": "revision_agent", "lane": "reflection", "col": 3, "type": "backend", "label": "Revision Agent", "sublabel": "只修订复核明确指出的问题", "width": 146 },
    { "id": "human_review", "lane": "branches", "col": 4, "type": "external", "label": "人工审核", "sublabel": "高风险或无法确认时由人决定", "width": 142 },
    { "id": "delivery", "lane": "delivery", "col": 5, "type": "frontend", "label": "回复交付", "sublabel": "交付已审核回复，不直接执行退款", "width": 148 },
    { "id": "followup_agent", "lane": "followup", "col": 5, "type": "backend", "label": "Follow-up Agent", "sublabel": "安排后续检查和升级提醒", "width": 146 },
    { "id": "persist_trace", "lane": "support", "col": 5, "type": "database", "label": "Checkpoint + Trace + Audit", "sublabel": "状态、证据版本、成本和审批留痕", "width": 172 }
  ],
  "edges": [
