  "metrics": [
    {
      "path": "metrics/next_day_retention.csv",
      "dataset_version": "metric_snapshot_20260831",
      "metric_name": "next_day_retention",
      "display_name": "次日留存率",
      "description": "次日活跃去重用户数 / 当日新增用户数，按平台、版本、渠道与设备分群拆分。含 2026-08-25 整日缺数、2026-08-24 低端机小样本（sample_size=312）与 2026-08-26 重复行等数据质量问题。",
      "unit": "ratio",
      "period": "day",
      "allowed_dimensions": ["platform", "app_version", "channel", "device"],
      "higher_is_better": true
    },
    {
      "path": "metrics/crash_rate.csv",
      "dataset_version": "metric_snapshot_20260831",
      "metric_name": "crash_rate",
      "display_name": "崩溃率",
      "description": "当日崩溃次数（含 java 与 native）/ 当日冷启动次数。iOS 不产出 low_end 分群；2026-08-25 整日缺数。与研发崩溃看板的 Java 层口径不一致。",
      "unit": "ratio",
      "period": "day",
      "allowed_dimensions": ["platform", "app_version", "channel", "device"],
      "higher_is_better": false
    },
    {
      "path": "metrics/dau.csv",
      "dataset_version": "metric_snapshot_20260831",
      "metric_name": "dau",
      "display_name": "日活跃用户数",
      "description": "当日存在启动行为的去重用户数，不提供 device 维度（device 列留空，sample_size 等于当日活跃用户数）。2026-08-25 整日缺数。",
      "unit": "count",
      "period": "day",
      "allowed_dimensions": ["platform", "app_version", "channel"],
      "higher_is_better": true
    },
    {
      "path": "metrics/order_conversion_rate.csv",
      "dataset_version": "metric_snapshot_20260831",
      "metric_name": "order_conversion_rate",
      "display_name": "下单转化率",
      "description": "当日下单去重用户数 / 当日活跃去重用户数，仅覆盖 Android 的 channel_a / channel_b，统计窗口为 2026-08-10 起。2026-08-25 整日缺数；2026-08-24 channel_a 低端机为小样本点。",
      "unit": "ratio",
      "period": "day",
      "allowed_dimensions": ["platform", "app_version", "channel", "device"],
      "higher_is_better": true
    }
  ],
