# =============================================================================
# 电商售后工单智能处理系统 —— 后端环境变量模板
#
# 用法：复制为 backend/.env 后按需修改（.env 不要提交到版本库）
#     PowerShell:  Copy-Item backend\.env.example backend\.env
#     bash:        cp backend/.env.example backend/.env
#
# 变量名 = backend/app/config.py 中字段名的大写形式（大小写不敏感）。
# 本文件是"模板"，**不要写入任何真实密钥**，密钥一律留空由部署环境注入。
#
# -----------------------------------------------------------------------------
# 默认策略：本地零依赖优先
#   不填任何密钥、不启动任何外部服务，下面的默认值即可跑通主流程：
#     数据库     SQLite 文件（自动创建）
#     向量       auto —— 有 pgvector 用 pgvector，否则退化为 Python 余弦相似度
#     缓存       auto —— Redis 可用就用，不可用退化为进程内缓存
#     对象存储   local —— 落盘到 <项目根>/data/objects
#     模型 / 向量化  stub —— 离线确定性输出，便于开发与测试
#   需要完整依赖（Postgres/Redis/MinIO/真实模型）时，取消对应注释块即可。
#   全栈容器化编排见 deploy/docker-compose.yml 与 deploy/README.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、基础
# -----------------------------------------------------------------------------
APP_NAME=电商售后工单智能处理系统
# local | dev | test | prod
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
# 正式交付证据只读目录；应用只读取固定 JSON，不在接口内生成或修改证据。
DELIVERY_EVIDENCE_DIR=../docs/testing/artifacts
# 目录内必须同时包含 after-sales-release-readiness.json、
# after-sales-delivery-check.json 和 delivery-evidence-manifest.json。
DELIVERY_EVIDENCE_MAX_AGE_HOURS=24
# 部署构建对应的完整 Git SHA；为空时看板明确显示“版本未绑定”。
APP_RELEASE_SHA=

# -----------------------------------------------------------------------------
# 二、数据库（本地零依赖默认：SQLite）
# -----------------------------------------------------------------------------
# 【默认，推荐】不设置 DATABASE_URL 时，自动使用 <项目根>/data/pic.db
# （SQLite 文件会自动创建，无需任何数据库服务）。
# 如需显式指定，注意 sqlite:/// 之后是路径，相对路径按"进程工作目录"解析，
# 建议直接写绝对路径，例如：
#   DATABASE_URL=sqlite:///D:/path/to/product-insight-copilot/data/pic.db
# 生产/容器环境使用 Postgres（驱动为 psycopg3，见文末"Postgres 容器"注释块）：
#   DATABASE_URL=postgresql+psycopg://pic:pic_dev_password@localhost:5432/pic
# DATABASE_URL=sqlite:///./data/pic.db

# 打印 SQL（排查问题时临时打开）
DB_ECHO=false
# 连接池，仅对 Postgres 等非 SQLite 生效
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# 三、向量检索
# -----------------------------------------------------------------------------
# auto | pgvector | fallback
#   auto     —— Postgres 且装了 pgvector 扩展时用 pgvector，否则 fallback
#   pgvector —— 强制使用 pgvector（SQLite 下会失败）
#   fallback —— 始终用 Python 余弦相似度，适合小数据量本地开发
VECTOR_BACKEND=auto
# 必须与所用 Embedding 模型维度一致（BGE-M3 = 1024）
EMBEDDING_DIM=1024
VECTOR_TABLE_NAME=chunk_vectors

# -----------------------------------------------------------------------------
# 四、缓存 / 幂等（本地零依赖默认：auto，Redis 缺失自动退化为进程内缓存）
# -----------------------------------------------------------------------------
# auto | redis | memory
CACHE_BACKEND=auto
CACHE_TTL_SECONDS=300
# Redis 地址（仅在启动 Redis 或使用容器编排时需要）
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 五、对象存储（本地零依赖默认：local 本地目录）
# -----------------------------------------------------------------------------
# local | minio
STORAGE_BACKEND=local
# 本地目录，默认 <项目根>/data/objects，一般无需修改
# STORAGE_LOCAL_DIR=D:/path/to/product-insight-copilot/data/objects
# 使用 MinIO / S3 兼容存储时（见文末"MinIO 容器"注释块）：
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=pic-documents
# MINIO_SECURE=false

# -----------------------------------------------------------------------------
# 六、认证与安全
# -----------------------------------------------------------------------------
# 【上线前必须替换】本地默认值仅供开发使用
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
# 默认 12 小时
JWT_EXPIRE_MINUTES=720
# argon2 | pbkdf2（pbkdf2 无需额外依赖，本地开发默认）
PASSWORD_SCHEME=pbkdf2
# 浏览器会话：生产默认 Secure=true（HTTPS）；本地 HTTP 保持 false/留空
AUTH_COOKIE_NAME=pic_session
AUTH_CSRF_COOKIE_NAME=pic_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_SAMESITE=lax
# 留空=按 APP_ENV 推导；生产为 true，本地为 false。仅在明确场景下覆盖。
# AUTH_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# 七、模型网关（本地零依赖默认：stub 离线桩，不需要任何密钥）
# -----------------------------------------------------------------------------
# openai_compatible | stub
LLM_PROVIDER=stub
# 接入真实模型时改为 openai_compatible，并填写 base_url / 密钥 / 模型名。
# 以 DeepSeek 为例（密钥只放服务端环境变量，禁止写入前端或日志）：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4000

# -----------------------------------------------------------------------------
# 七之二、多模型路由（按 Agent / 节点覆盖模型，未列出的自动落回上面的全局配置）
# -----------------------------------------------------------------------------
# 值是 JSON，键可以是 Agent 代码：product_agent / feedback_agent / release_agent /
# metric_agent / report_agent，也可以是代码节点：intent_classifier / answerability_check。
# 可覆盖字段：model、base_url、api_key、temperature、max_output_tokens、timeout_seconds、max_retries。
# 典型用法：报告 Agent 用强模型，反馈聚类用便宜快的模型，甚至跨供应商混用。
# 注意：仍需把 LLM_PROVIDER 设为 openai_compatible，provider 是总开关。
AGENT_MODEL_OVERRIDES={}

# 示例一：同一家厂商内换型号（报告 Agent 用推理模型）
# AGENT_MODEL_OVERRIDES={"report_agent":{"model":"deepseek-reasoner"}}

# 示例二：跨供应商混用（报告 Agent 用 DeepSeek，反馈聚类用通义千问）
# AGENT_MODEL_OVERRIDES={"report_agent":{"model":"deepseek-reasoner"},"feedback_agent":{"model":"qwen-max","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"sk-xxx"}}

# 示例三：给代码节点也单独配小模型以省成本
# AGENT_MODEL_OVERRIDES={"intent_classifier":{"model":"qwen-turbo"},"answerability_check":{"model":"qwen-turbo"}}

# 示例四（本项目当前在用的分工，DeepSeek）：
#   * 报告 Agent 用强推理模型 deepseek-reasoner（跨来源推断、优先级与置信度判断、措辞）
#     并把 timeout_seconds / max_output_tokens 放宽（推理模型耗时更长、输出 JSON 最长）
#   * 四个分析 Agent 与两个代码节点用快模型 deepseek-chat（从工具结果里抽取结构化事实）
# 注：DeepSeek 没有 pro/flash 命名，deepseek-reasoner ≈ 强模型、deepseek-chat ≈ 快模型。
# AGENT_MODEL_OVERRIDES={"report_agent":{"model":"deepseek-reasoner","timeout_seconds":180,"max_retries":1,"max_output_tokens":8000},"product_agent":{"model":"deepseek-chat"},"feedback_agent":{"model":"deepseek-chat"},"release_agent":{"model":"deepseek-chat"},"metric_agent":{"model":"deepseek-chat"},"intent_classifier":{"model":"deepseek-chat"},"answerability_check":{"model":"deepseek-chat"}}

# 每个 Agent 是否真的用上了模型，可在 agent_runs.model（配置的模型）与
# agent_runs.output.model_used（本次是否真的用到模型输出）里逐条核对；
# output.model_error 会写明失败原因（未配置 / 超时 / 输出非法 JSON）。

# Embedding：openai_compatible（可对接 BGE-M3 服务化接口）| stub
EMBEDDING_PROVIDER=stub
# 示例：本地部署 BGE-M3（OpenAI 兼容协议）
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://localhost:9997/v1
# EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FAILURE_MODE=fallback

# -----------------------------------------------------------------------------
# 八、工作流 / Agent 受控参数（超时、重试、循环上限）
# -----------------------------------------------------------------------------
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIES=1
AGENT_MAX_TOKENS=6000
# 单个 Agent 一次运行内允许的工具调用次数（超出即拒绝并记审计）
AGENT_MAX_TOOL_CALLS=6
WORKFLOW_MAX_RETRIEVE_ROUNDS=2
# 有界反思默认关闭；灰度环境显式开启。Reflection/Revision Agent 不具备工具权限。
REFLECTION_ENABLED=false
REFLECTION_TICKET_ENABLED=true
REFLECTION_REPORT_ENABLED=true
# 服务端稳定分桶；作用域留空表示全部。列表使用 JSON，例：["demo"]。
REFLECTION_ROLLOUT_PERCENT=100
REFLECTION_ROLLOUT_SALT=reflection-rollout-v1
REFLECTION_ROLLOUT_TENANTS=[]
REFLECTION_ROLLOUT_RISK_LEVELS=[]
REFLECTION_ROLLOUT_ISSUE_TYPES=[]
REFLECTION_ROLLOUT_AUTO_GUARD=true
# 每侧样本不足该值时只保持，不给扩大结论。
REFLECTION_RELEASE_MIN_SAMPLE=20
REFLECTION_RELEASE_ERROR_RATE_LIMIT=0.05
REFLECTION_RELEASE_BOUNDED_TERMINATION_MIN=0.98
REFLECTION_RELEASE_LATENCY_MULTIPLIER=1.5
REFLECTION_RELEASE_TOKEN_MULTIPLIER=1.5
# 允许自动修订的最大次数，范围 0~2；默认 1 次修订后再次复核。
MAX_REFLECTION_ROUNDS=1
REFLECTION_TIMEOUT_SECONDS=30
REFLECTION_MAX_TOKENS=1800
# 0 表示不单独限制；生产建议结合真实模型基线设置。
REFLECTION_COST_LIMIT=0
# 报告最多引用的证据条数（防止报告被证据淹没）
REPORT_MAX_EVIDENCE=30
# 证据充分性：低于该相关度视为噪声，不计入证据
EVIDENCE_MIN_RELEVANCE=0.02
# 冲突判定：同一事实下反向表述的相似度阈值
CONFLICT_SIMILARITY_THRESHOLD=0.35
# 版本号随 Prompt / Embedding / 索引变更而递增，用于结果可追溯
WORKFLOW_VERSION=wf-1.0.0
PROMPT_VERSION=prompt-1.0.0
EMBEDDING_VERSION=emb-1.0.0
INDEX_VERSION=index-1.0.0

# 触发人工审核的阈值
RISK_SCORE_HIGH_THRESHOLD=0.7
CONFIDENCE_LOW_THRESHOLD=0.6
MIN_EVIDENCE_COUNT=3

# -----------------------------------------------------------------------------
# 九、售后事实适配器（订单 / 支付 / 物流 / 售后，只读）
# -----------------------------------------------------------------------------
# 本地与演示默认 true；生产必须设 false，并配置下方四个标准化 HTTP 端点。
TICKET_USE_MOCK_ADAPTERS=true
# URL 必须包含 {order_id}，订单号会按 URL path segment 编码后替换。
TICKET_FACT_ORDER_URL=
TICKET_FACT_PAYMENT_URL=
TICKET_FACT_LOGISTICS_URL=
TICKET_FACT_AFTERSALE_URL=
# 服务端专用鉴权头（JSON），不会进入 /health、日志或前端。
# 示例：{"Authorization":"Bearer replace-me"} 或 {"X-API-Key":"replace-me"}
TICKET_FACT_AUTH_HEADERS={}
TICKET_FACT_TIMEOUT_SECONDS=3
TICKET_FACT_MAX_RETRIES=2
TICKET_FACT_RETRY_BACKOFF_SECONDS=0.2
# MCP 只读适配基础层默认关闭。当前只提供注入式适配器契约，不会自动连接此地址。
# 真正启用前需拿到服务传输、鉴权、租户隔离和四个只读工具的正式 Schema。
TICKET_FACT_MCP_ENABLED=false
TICKET_FACT_MCP_ENDPOINT=
TICKET_FACT_MCP_MAX_RESPONSE_BYTES=262144

# -----------------------------------------------------------------------------
# 十、指标导入与演示数据
# -----------------------------------------------------------------------------
# 单次导入允许的最大行数，超出直接拒绝（防止误传超大文件拖垮服务）
METRIC_IMPORT_MAX_ROWS=200000
# 比例类指标的合理上界，超过则记质量标记（不直接拒绝，交由人工判断）
METRIC_RATIO_BOUNDS=1.5
# 演示数据目录（播种脚本与离线评测使用），默认 <backend>/data/demo
# DEMO_DATA_DIR=D:/path/to/product-insight-copilot/backend/data/demo

# -----------------------------------------------------------------------------
# 十一、成本控制与稳定性（阶段六）
# -----------------------------------------------------------------------------
# 计费表：模型名 -> 每百万 token 单价；支持 "qwen-*" 通配前缀。
# ⚠️ 下面的数字只是示例，供应商会调价 —— 请按控制台实际价格覆盖。
MODEL_PRICES={"deepseek-chat":{"input":2.0,"output":8.0,"cache_hit_input":0.5},"deepseek-reasoner":{"input":4.0,"output":16.0,"cache_hit_input":1.0}}
# 未登记模型的兜底单价（宁可高估，也不要漏算）
MODEL_PRICE_DEFAULT={"input":4.0,"output":16.0,"cache_hit_input":1.0}
CURRENCY=CNY

# 预算上限：0 = 不限制
# 单任务 token 上限（比金额更直观，适合先卡住"失控放大"）
TASK_TOKEN_LIMIT=0
# 单任务成本上限
TASK_COST_LIMIT=0
# 单租户单日成本上限（超过后创建任务直接 429）
TENANT_DAILY_COST_LIMIT=0
# 超预算后的动作：degrade=停止调用模型改用确定性归纳继续出报告；abort=任务失败可重试
BUDGET_EXCEEDED_ACTION=degrade

# 主模型失败时的备用模型（JSON 数组，顺序即降级顺序；也可按 Agent 配 fallback_models）
LLM_FALLBACK_MODELS=[]

# 模型灰度：按"任务"百分比分桶试用候选模型，其余任务继续用对照模型（详见 README §3.4）
# 例：报告 Agent 的候选模型先放 15% 流量
MODEL_CANARY={}
# MODEL_CANARY={"report_agent":{"model":"deepseek-reasoner-v2","percent":15}}
# 分桶盐值：改它会重新分配哪批任务进灰度（排查问题时用来换样）
MODEL_CANARY_SALT=pic-canary-1

# 全局模型调用并发上限（多个 Agent 并行时避免打满供应商限流）
MODEL_MAX_CONCURRENCY=4
# 等待并发额度的最长时间（秒），超时按调用失败处理并走降级链
MODEL_CONCURRENCY_TIMEOUT_SECONDS=30
# 单用户每分钟最多创建多少任务；0 = 不限制（多副本部署需接 Redis 才能全局生效）
TASK_SUBMIT_RATE_LIMIT_PER_MINUTE=20
# 单个「直连 IP + 用户名」每分钟最多尝试登录次数；生产不可设为 0
LOGIN_ATTEMPT_RATE_LIMIT_PER_MINUTE=10

# 缓存 TTL（秒）：0 = 关闭。key 里带数据指纹，入库/重建/导入后自动失效
RETRIEVAL_CACHE_TTL_SECONDS=300
METRIC_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# 任务执行与断点恢复（多副本生产化，详见 README §7.4）
# -----------------------------------------------------------------------------
# inline=接口内同步执行（测试/单机调试）；threadpool=本进程线程池（单副本默认）；
# queue=写入任务队列由 worker 进程领取（多副本安全，配合 python -m app.worker）
TASK_EXECUTION_BACKEND=threadpool
# queue 模式下是否在 API 进程内顺带跑一个 worker（本地开发方便；生产应为 false）
WORKER_EMBEDDED=true
# worker 并发领取数 / 空闲轮询间隔（秒）/ 任务租约（秒，超时未 ack 会被回收重跑）
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=600
# 单任务最多被领取执行几次，超过标记 dead（避免坏任务无限重试）
WORKER_MAX_ATTEMPTS=3
# worker 标识，留空则用「主机名-PID」
WORKER_ID=

# 运行告警站外通知：默认关闭。启用后走数据库 outbox 异步投递，不阻塞业务事务。
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
# HMAC-SHA256 签名密钥；生产启用 Webhook 时必填，只放服务端环境变量，禁止提交真实值。
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_MAX_ATTEMPTS=5
ALERT_WEBHOOK_RETRY_BASE_SECONDS=10
ALERT_WEBHOOK_POLL_INTERVAL_SECONDS=2
ALERT_WEBHOOK_LEASE_SECONDS=30

# 只读主动异常触发器：默认关闭。启用后扫描标准化指标并生成候选告警，
# 不会自动调用模型或派发诊断；必须由管理员在系统状态页人工确认。
PROACTIVE_ANOMALY_ENABLED=false
PROACTIVE_ANOMALY_METRICS=["next_day_retention","crash_rate"]
PROACTIVE_ANOMALY_LOOKBACK_DAYS=30
# 最新指标日期最多允许落后 UTC 今天 2 天；超期或未来日期会被跳过，不生成候选告警。
PROACTIVE_ANOMALY_MAX_DATA_AGE_DAYS=2
# 可按指标覆盖最大延迟；键必须属于 PROACTIVE_ANOMALY_METRICS，值范围 0~365。
PROACTIVE_ANOMALY_MAX_DATA_AGE_BY_METRIC={}
PROACTIVE_ANOMALY_METHOD=zscore
PROACTIVE_ANOMALY_THRESHOLD=2.5
# 独立调度进程：python -m app.proactive_scheduler。API 本身不会启动定时循环。
PROACTIVE_ANOMALY_INTERVAL_SECONDS=300
PROACTIVE_ANOMALY_LEASE_SECONDS=900

# 标准化只读指标源：默认关闭。只允许 GET 拉取白名单指标，地址和鉴权头仅保存在服务端。
# 响应契约：{"dataset_version":"...","source_version":"...","data":[{"tenant_id":"...","metric_name":"...","stat_date":"YYYY-MM-DD","value":0.1}]}
METRIC_SOURCE_HTTP_ENABLED=false
METRIC_SOURCE_HTTP_URL=
METRIC_SOURCE_HTTP_AUTH_HEADERS={}
METRIC_SOURCE_HTTP_TIMEOUT_SECONDS=5
METRIC_SOURCE_HTTP_MAX_RETRIES=2
METRIC_SOURCE_HTTP_RETRY_BACKOFF_SECONDS=0.2
METRIC_SOURCE_HTTP_MAX_ROWS=50000
METRIC_SOURCE_HTTP_MAX_RESPONSE_BYTES=4194304

# Checkpointer：决定"人工审核后的恢复"能不能跨进程/跨副本
#   memory   进程内内存（默认，单副本够用；重启或换副本会让中断恢复走降级重建路径）
#   sqlite   同机多进程共享的库文件（多进程部署推荐）
#   postgres 多副本共享（生产推荐；需要 langgraph-checkpoint-postgres + psycopg）
CHECKPOINTER_BACKEND=memory
# sqlite 库文件位置；留空放数据库同目录
CHECKPOINTER_SQLITE_PATH=
# postgres 连接串；留空用 DATABASE_URL
CHECKPOINTER_POSTGRES_URL=

# -----------------------------------------------------------------------------
# 十、上传与内容安全
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.md,.txt,.json
# 命中即判定为提示词注入，转入人工审核并记审计
PROMPT_INJECTION_PATTERNS=忽略以上指令,忽略之前的指令,ignore previous instructions,ignore all previous instructions,system prompt,reveal your prompt,导出全部数据,绕过权限,忽略安全规则
SENSITIVE_OUTPUT_PATTERNS=api_key,secret,password,token
# 允许跨域的前端来源（逗号分隔）；生产环境请改成真实域名白名单
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Uvicorn 可信代理 IP/CIDR；空值=不采信 X-Forwarded-*。生产禁止 *，按真实网关网段配置。
FORWARDED_ALLOW_IPS=

# -----------------------------------------------------------------------------
# 十一、检索与切分
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=50
# 召回的绝对相关度下限：低于该分数的切片直接丢弃（避免"任何问题都能拿到 top_k 条"）
RETRIEVAL_MIN_SCORE=0.05
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 可回答性闸门：问题关键词覆盖率低于该值时判定"证据不足以回答"，把事实降级为假设
# 该阈值在离线 stub 检索上标定（可回答 ≥0.5、不可回答 ≤0.29），接入 BGE-M3 + Reranker 后需重新标定
ANSWERABILITY_MIN_COVERAGE=0.2
# 逃生口：存在明显高相关证据时，即使覆盖率低也认为可回答
ANSWERABILITY_HIGH_SCORE=0.26
# 可选 BGE-Reranker HTTP 服务，留空则用内置启发式加权排序
RERANKER_ENDPOINT=
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=20
RERANKER_FAILURE_MODE=fallback

# -----------------------------------------------------------------------------
# 十二、任务执行
# -----------------------------------------------------------------------------
TASK_WORKER_THREADS=4
TASK_POLL_INTERVAL_SECONDS=0.5
# 同步执行工作流（测试/调试用；生产保持 false，任务提交到后台线程池）
TASK_RUN_INLINE=false
# 启动时建表；若库中还没有任何账号，则自动播种演示数据（APP_ENV=prod 时必须关闭）
AUTO_INIT_DB=true
AUTO_SEED=true
# 启动时把上次进程中断遗留的 running/pending 任务标记为失败可重试
# （工作流跑在进程内线程池，进程退出后没人能推进它，不做清理会永远显示"执行中"）
RECONCILE_STALE_TASKS=true
# 前端构建产物目录：存在时挂到根路径 "/"（同源访问，免 CORS）
# FRONTEND_DIST_DIR=<项目根>/frontend/dist

